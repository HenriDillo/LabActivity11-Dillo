<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ ^%{REQUEST_FILENAME} [QSA,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^ index.php [L]
</IfModule>
